#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

## husky task runner examples -------------------
## Note : for local installation use 'dotnet' prefix. e.g. 'dotnet husky'

## run all tasks
#husky run

### run all tasks with group: 'group-name'
#husky run --group group-name

## run task with name: 'task-name'
#husky run --name task-name

## pass hook arguments to task
#husky run --args "$1" "$2"

## or put your custom commands -------------------
#echo 'Husky.Net is awesome!'

# Git 저장소 루트로 이동
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1

# merge 또는 revert 작업 중에는 Hook을 실행하지 않음
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] ||
   [ -f "$(git rev-parse --git-path REVERT_HEAD)" ]; then
    echo "merge/revert 커밋이므로 Husky 검사를 건너뜁니다."
    exit 0
fi

# Solution 탐색
slnx_files=$(find . -maxdepth 1 -type f -name '*.slnx')
slnx_count=$(printf '%s\n' "$slnx_files" | sed '/^$/d' | wc -l)

sln_files=$(find . -maxdepth 1 -type f -name '*.sln')
sln_count=$(printf '%s\n' "$sln_files" | sed '/^$/d' | wc -l)

if [ "$slnx_count" -eq 1 ]; then
    solution=$(printf '%s\n' "$slnx_files" | head -n 1)

elif [ "$slnx_count" -gt 1 ]; then
    echo "여러 개의 .slnx 파일이 존재합니다."
    exit 1

elif [ "$sln_count" -eq 1 ]; then
    solution=$(printf '%s\n' "$sln_files" | head -n 1)

elif [ "$sln_count" -gt 1 ]; then
    echo "여러 개의 .sln 파일이 존재합니다."
    exit 1

else
    echo "솔루션 파일(.sln/.slnx)을 찾을 수 없습니다."
    exit 1
fi

echo "사용할 솔루션: $solution"

dotnet format "$solution" \
    --verify-no-changes \
    --severity warn \
    --include Assets/02_Scripts/